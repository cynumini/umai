/// f32,i32
#include "sakana.h"
/// h
$t$ $l$_max($t$ a, $t$ b);
$t$ $l$_min($t$ a, $t$ b);
$t$ $l$_clamp($t$ value, $t$ min, $t$ max);
/// c
$t$ $l$_max($t$ a, $t$ b) { return a > b ? a : b; }
$t$ $l$_min($t$ a, $t$ b) { return a < b ? a : b; }
$t$ $l$_clamp($t$ value, $t$ lower, $t$ upper)
{
    if (value < lower)
    {
        return lower;
    }
    else if (value > upper)
    {
        return upper;
    }
    else
    {
        return value;
    }
}
